[gd_scene format=3]

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Content" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Title" type="Label" parent="Center/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 0.27, 0.23, 1)
theme_override_font_sizes/font_size = 52
text = "Four Otters"
horizontal_alignment = 1

[node name="Description" type="Label" parent="Center/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 0.27, 0.23, 1)
theme_override_font_sizes/font_size = 24
text = "Draw something. Help someone."
horizontal_alignment = 1

[node name="Status" type="Label" parent="Center/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.38, 0.42, 0.37, 1)
theme_override_font_sizes/font_size = 18
text = "Our first Godot scene is running."
horizontal_alignment = 1
